# Public (browser-safe) Supabase keys only. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Map provider: "osm" (default, no key needed) | "google"
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=

# Payment provider used by the frontend adapter: "mock" | "edge"
# "edge" routes payment intents to the Supabase Edge Function `payments`.
VITE_PAYMENT_PROVIDER=mock

# LINE Login channel ID (public; shown in the authorize URL). Setting it shows the LINE button.
# The channel SECRET must NOT go here: use `supabase secrets set LINE_CHANNEL_SECRET=...`.
VITE_LINE_CHANNEL_ID=

VITE_DEFAULT_LOCALE=en
