    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "pg": "^8.23.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
